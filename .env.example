# ==============================================================================
# OpenAI API & Feature-Specific Model Configuration
# ==============================================================================

# Shared OpenAI API Key used for authentication across all AI features
OPENAI_API_KEY="sk-..."

# 1) Report / Document Translation Model
# Controls the AI model used during report and document translation generation workflows.
# Available models: gpt-5.6 (default), gpt-4o, gpt-4o-mini, o1, o3-mini, gpt-4.5-preview
# Default fallback: gpt-5.6 (or OPENAI_TRANSLATION_MODEL if set)
OPENAI_REPORT_TRANSLATION_MODEL="gpt-5.6"

# 2) Voice-to-Text / Audio Transcription Model
# Controls the speech-to-text model used in the voice recording flow.
# Available models: whisper-1 (default), gpt-4o-audio-preview, gpt-4o-mini-audio-preview
# Default fallback: whisper-1
OPENAI_TRANSCRIPTION_MODEL="whisper-1"

# 3) Form Text Enhancement & Translation Helper Model
# Controls the AI model used in the form text enhancement & inline translation helper.
# Available models: gpt-4o-mini (default), gpt-4o, gpt-3.5-turbo
# Default fallback: gpt-4o-mini
OPENAI_ENHANCE_TEXT_MODEL="gpt-4o-mini"

# 4) AI Summary Model
# Controls the AI model used for multi-document AI summary generation.
# Available models: gpt-5.6 (default), gpt-4o, gpt-4o-mini, o1, o3-mini
# Default fallback: gpt-5.6
OPENAI_SUMMARY_MODEL="gpt-5.6"
