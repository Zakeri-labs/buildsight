# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Canonical public production origin, for example https://buildsight.example.com
NEXT_PUBLIC_SITE_URL=
# Legacy local-development override only. Never set this to localhost in production.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
POSTGRES_URL_NON_POOLING=

# Location search and map. No secret key is required for the default OpenStreetMap setup.
LOCATION_GEOCODING_BASE_URL=https://photon.komoot.io
LOCATION_GEOCODING_USER_AGENT=BuildSight/1.0
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
NEXT_PUBLIC_MAP_DEFAULT_LATITUDE=23.5880
NEXT_PUBLIC_MAP_DEFAULT_LONGITUDE=58.3829
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=11

# Project stage inspection evidence
NEXT_PUBLIC_STAGE_EVIDENCE_MAX_IMAGES=8

# Server-side AI features (Summary and Document Translation)
OPENAI_API_KEY=

# Optional override for the PDF-safe Noto Naskh Arabic TTF used by direct jsPDF export.
# The default is a pinned public Noto font URL.
ARABIC_PDF_FONT_URL=
# Server-side email delivery through Resend
RESEND_API_KEY=
# Verified sender used for organization invitation emails.
# Falls back to SITE_VISIT_FROM_EMAIL only when this value is empty.
INVITATION_FROM_EMAIL=BuildSight <invitations@example.com>
# Optional sender used for report CC emails.
REPORT_CC_FROM_EMAIL=BuildSight <notifications@example.com>
# Sender used for Site Visit Request emails.
SITE_VISIT_FROM_EMAIL=Bonyan Platform <notifications@example.com>
